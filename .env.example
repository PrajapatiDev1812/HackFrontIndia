# ==========================================
# GITHUB API
# ==========================================
# Get this from: GitHub Settings -> Developer settings -> Personal access tokens (classic)
GITHUB_TOKEN=

# ==========================================
# LLM PROVIDERS
# ==========================================
# Google AI Studio (Gemini 1.5 Flash) - Get from: aistudio.google.com
GOOGLE_API_KEY=

# Groq (Optional backup for fast Llama 3.1) - Get from: console.groq.com
GROQ_API_KEY=

# ==========================================
# NEO4J DATABASE (Local Docker Dev)
# ==========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ==========================================
# NEO4J DATABASE (AuraDB Cloud Prod)
# ==========================================
# Get these from: Neo4j Aura Console -> Connect -> Connection URI
NEO4J_AURA_URI=
NEO4J_AURA_USERNAME=neo4j
NEO4J_AURA_PASSWORD=

# ==========================================
# APP CONFIGURATION
# ==========================================
# Limit PRs for ingestion (keep low for testing, max 200 for free tier)
MAX_PRS=20

# LLM Selection: "ollama", "gemini", or "groq"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
