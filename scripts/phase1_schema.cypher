CREATE CONSTRAINT repo_id IF NOT EXISTS FOR (r:Repo) REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT pr_id IF NOT EXISTS FOR (p:PR) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT commit_sha IF NOT EXISTS FOR (c:Commit) REQUIRE c.sha IS UNIQUE;
CREATE CONSTRAINT file_path IF NOT EXISTS FOR (f:File) REQUIRE f.path IS UNIQUE;
CREATE CONSTRAINT dev_login IF NOT EXISTS FOR (d:Developer) REQUIRE d.login IS UNIQUE;
CREATE CONSTRAINT decision_id IF NOT EXISTS FOR (dec:Decision) REQUIRE dec.id IS UNIQUE;
CREATE CONSTRAINT topic_name IF NOT EXISTS FOR (t:Topic) REQUIRE t.name IS UNIQUE;

CREATE INDEX pr_state IF NOT EXISTS FOR (p:PR) ON (p.state);
CREATE INDEX pr_merged_at IF NOT EXISTS FOR (p:PR) ON (p.merged_at);
CREATE INDEX decision_type IF NOT EXISTS FOR (d:Decision) ON (d.decision_type);
CREATE INDEX file_path_idx IF NOT EXISTS FOR (f:File) ON (f.path);
